# Server Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/ai-resume-builder

# JWT Authentication
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed Frontend Client Origin(s) - comma-separated for multiple origins
CLIENT_URL=http://localhost:5173

# Gemini API Key for AI features
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_AGENT_MODEL=gemini-2.0-flash

# Keep ATS scoring deterministic and fast. Set true only to add optional
# Gemini-written qualitative insights after deterministic scoring.
ATS_AI_INSIGHTS=false

# Google Sign-In
GOOGLE_CLIENT_ID=your-google-client-id
